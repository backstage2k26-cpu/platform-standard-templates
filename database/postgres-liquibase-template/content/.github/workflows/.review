##############################################################################
# Liquibase / PostgreSQL Review CI Pipeline
#
# Mirrors the Jenkins "edd-spanner-wallet" review pipeline, adapted for
# Liquibase + PostgreSQL instead of Spanner:
#
#   Jenkins stage                 -> GitHub Actions job/step
#   ----------------------------------------------------------------------
#   Checkout                      -> actions/checkout
#   Build artifact (Maven)        -> setup-java + mvn build
#   Prepare artifact               -> untar build output
#   Docker build                  -> docker/build-push-action, build ONLY
#                                     (push happens in release.yml post-merge,
#                                     not here)
#   Spanner setup (create DB)     -> postgres "services:" container (ephemeral,
#                                     created and destroyed automatically by
#                                     the runner, no manual create/delete step)
#   Applying master version       -> liquibase update using base/main branch
#                                     changelog, then a baseline tag
#   Applying current version      -> liquibase update using PR branch
#                                     changelog, then rollback to baseline tag
#   post { always { ... } }       -> "Collect logs" + "if: always()" steps
#
# Required repo secrets:
#   DOCKERHUB_USERNAME   - Docker Hub username
#   DOCKERHUB_TOKEN      - Docker Hub access token (not your password)
#
# Assumptions (adjust to match your repo layout):
#   - pom.xml at repo root, produces target/<app>-<version>.tar.gz
#   - Liquibase changelogs live under db/changelog/db.changelog-master.xml
#   - GCP project "My First Project" (project-17c879d2-ad15-4d2d-b9d) is
#     referenced only as metadata/labels here since DB provisioning is no
#     longer done against GCP (Postgres is ephemeral in the runner). If you
#     later move to Cloud SQL, replace the "postgres:" service block with a
#     "gcloud sql" create/delete step using workload identity federation
#     instead of a long-lived JSON key.
##############################################################################

name: Liquibase Review Pipeline

on:
  pull_request:
    branches: [main]
  workflow_dispatch: {}

env:
  APPLICATION: edd-wallet-postgres          # <-- rename to your app
  GCP_PROJECT_ID: project-17c879d2-ad15-4d2d-b9d
  CHANGELOG_MASTER: db/changelog/db.changelog-master.xml
  DOCKERHUB_REPO: yourdockerhubuser/edd-wallet-postgres   # <-- rename
  PGHOST: localhost
  PGPORT: 5432
  PGDATABASE: reviewdb
  PGUSER: reviewuser
  PGPASSWORD: reviewpass   # test-only creds for the ephemeral container

concurrency:
  group: liquibase-review-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: true

jobs:
  review:
    name: Liquibase review (PR #${{ github.event.pull_request.number }})
    runs-on: ubuntu-latest
    timeout-minutes: 60

    # ---- "Spanner setup" equivalent: ephemeral Postgres for this run only.
    # GitHub tears this container down automatically when the job ends,
    # so there is no manual create/delete step needed (unlike the
    # gcloud spanner databases create/delete calls in Jenkins).
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: reviewuser
          POSTGRES_PASSWORD: reviewpass
          POSTGRES_DB: reviewdb
        ports:
          - 5432:5432
        options: >-
          --health-cmd="pg_isready -U reviewuser -d reviewdb"
          --health-interval=5s
          --health-timeout=5s
          --health-retries=10

    steps:
      # ---------------- Checkout (PR branch) ----------------
      - name: Checkout PR branch
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set commit status - running
        uses: actions/github-script@v7
        with:
          script: |
            await github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state: 'pending',
              context: 'liquibase-review',
              description: 'Review pipeline running'
            });

      # ---------------- Build artifact (Maven) ----------------
      - name: Set up JDK 8
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '8'
          cache: maven

      - name: Build artifact
        run: |
          mvn build-helper:parse-version versions:set \
            -DnewVersion='${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${{ github.run_number }}' \
            -DgenerateBackupPoms=false -B
          mvn clean install -e -B
          echo "ARTIFACT_VERSION=$(mvn help:evaluate -Dexpression=project.version -q -DforceStdout)" >> "$GITHUB_ENV"

      # ---------------- Prepare artifact ----------------
      - name: Prepare artifact
        working-directory: target
        run: |
          ls -lart
          tar -xzvf "${APPLICATION}-${ARTIFACT_VERSION}.tar.gz"
          rm "${APPLICATION}-${ARTIFACT_VERSION}.tar.gz"
          ls -lart

      # ---------------- Docker build (validation only, no push) ----------------
      # Pushing to Docker Hub is deliberately NOT done here. Only the
      # post-merge release pipeline (.github/workflows/release.yml) pushes
      # images. This step just proves the Dockerfile still builds cleanly
      # for this PR — same signal Jenkins' "Docker build" stage gave, minus
      # publishing anything.
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build review image (no push)
        uses: docker/build-push-action@v6
        with:
          context: target
          push: false
          load: false
          tags: |
            ${{ env.DOCKERHUB_REPO }}:pr-${{ github.event.pull_request.number || github.run_number }}
          labels: |
            gcp.project=${{ env.GCP_PROJECT_ID }}
            app=${{ env.APPLICATION }}

      - name: Wait for Postgres
        run: |
          for i in $(seq 1 30); do
            pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" && break
            echo "waiting for postgres..."; sleep 2
          done

      # ---------------- Applying master version ----------------
      # Equivalent to Jenkins "Applying master version": run the base
      # branch's changelog against the fresh DB to establish a baseline
      # before layering on the PR's new changesets.
      - name: Checkout base branch changelog
        run: |
          git fetch origin "${{ github.event.pull_request.base.ref || 'main' }}"
          git worktree add /tmp/base-changelog "origin/${{ github.event.pull_request.base.ref || 'main' }}"

      - name: Apply master (base) changelog
        run: |
          docker run --rm --network host \
            -v /tmp/base-changelog/db/changelog:/liquibase/changelog \
            liquibase/liquibase:4.29 \
            --changeLogFile=changelog/db.changelog-master.xml \
            --url="jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}" \
            --username="$PGUSER" --password="$PGPASSWORD" \
            update
        continue-on-error: false

      - name: Tag baseline
        run: |
          docker run --rm --network host \
            -v /tmp/base-changelog/db/changelog:/liquibase/changelog \
            liquibase/liquibase:4.29 \
            --changeLogFile=changelog/db.changelog-master.xml \
            --url="jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}" \
            --username="$PGUSER" --password="$PGPASSWORD" \
            tag review-baseline

      # ---------------- Applying current version ----------------
      # Equivalent to Jenkins "Applying current version": apply the PR
      # branch's changelog (adds the new changesets), capturing logs on
      # failure the same way the Jenkins job dumps pod logs.
      - name: Apply current (PR) changelog
        id: apply_current
        run: |
          set -o pipefail
          docker run --rm --network host \
            -v "${{ github.workspace }}/db/changelog:/liquibase/changelog" \
            liquibase/liquibase:4.29 \
            --changeLogFile=changelog/db.changelog-master.xml \
            --url="jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}" \
            --username="$PGUSER" --password="$PGPASSWORD" \
            update 2>&1 | tee current-update.log

      - name: Show current update logs on failure
        if: failure() && steps.apply_current.outcome == 'failure'
        run: cat current-update.log || true

      # ---------------- Rollback test ----------------
      # Equivalent to the Jenkins rollback-schema job: proves the PR's
      # changesets can be safely rolled back to the baseline tag.
      - name: Rollback PR changelog to baseline
        id: rollback
        run: |
          set -o pipefail
          docker run --rm --network host \
            -v "${{ github.workspace }}/db/changelog:/liquibase/changelog" \
            liquibase/liquibase:4.29 \
            --changeLogFile=changelog/db.changelog-master.xml \
            --url="jdbc:postgresql://${PGHOST}:${PGPORT}/${PGDATABASE}" \
            --username="$PGUSER" --password="$PGPASSWORD" \
            rollback review-baseline 2>&1 | tee rollback.log

      - name: Show rollback logs on failure
        if: failure() && steps.rollback.outcome == 'failure'
        run: cat rollback.log || true

      # ---------------- post { always {...} } equivalent ----------------
      - name: Upload logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: liquibase-review-logs-${{ github.run_number }}
          path: |
            current-update.log
            rollback.log
          if-no-files-found: ignore

      - name: Clean up base-branch worktree
        if: always()
        run: git worktree remove /tmp/base-changelog --force || true

      - name: Set commit status - result
        if: always()
        uses: actions/github-script@v7
        with:
          script: |
            const state = '${{ job.status }}' === 'success' ? 'success' : 'failure';
            await github.rest.repos.createCommitStatus({
              owner: context.repo.owner,
              repo: context.repo.repo,
              sha: context.sha,
              state,
              context: 'liquibase-review',
              description: state === 'success' ? 'Review pipeline passed' : 'Review pipeline failed'
            });

    # Note: the postgres "services:" container above is destroyed
    # automatically by the runner at the end of the job — this is the
    # GitHub Actions equivalent of Jenkins' final
    # "gcloud spanner databases delete ${DB_ID}" cleanup step, but
    # requires no explicit teardown code.